# LyricTrace backend configuration (all optional — the defaults below are the built-in values).
# Copy to .env and export it, or pass these as environment variables when starting uvicorn.
# The backend does not read .env automatically; use `set -a; source .env; set +a` or your process manager.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Root for the SQLite database and uploaded audio files.
# Defaults to <repo>/data. Relative paths resolve against the process CWD.
# LYRICTRACE_DATA_DIR=./data
# Override just the database path (defaults to $LYRICTRACE_DATA_DIR/lyrictrace.db).
# LYRICTRACE_DB_PATH=./data/lyrictrace.db
LYRICTRACE_MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the Vite dev server by default).
LYRICTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# LRCLIB
# ---------------------------------------------------------------------------
LYRICTRACE_LRCLIB_URL=https://lrclib.net
LYRICTRACE_LRCLIB_TIMEOUT=15
LYRICTRACE_LRCLIB_MAX_RESULTS=10
LYRICTRACE_USER_AGENT=LyricTrace/0.1.0 (https://github.com/lyrictrace)

# ---------------------------------------------------------------------------
# Fallback lyric sources (tried in this order after LRCLIB comes up empty)
# ---------------------------------------------------------------------------
# Internal LrcApi deployment (Kugou). Empty disables it.
LYRICTRACE_LRCAPI_URL=
LYRICTRACE_LRCAPI_TIMEOUT=30
# NetEase Cloud Music. Empty disables it.
LYRICTRACE_NETEASE_URL=https://music.163.com
LYRICTRACE_NETEASE_TIMEOUT=15

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------
# Metadata extractor: `llm` (LLM reads the messy filename; falls back to the
# rule-based parser) or `filename` (rule-based only, no network calls).
LYRICTRACE_METADATA_EXTRACTOR=llm
# Fetch the original lyrics after upload (LRCLIB → LrcApi → NetEase). Lyrics the
# user pastes or edits always win; only the text is taken, and a source timeline
# is kept as a positional hint for the aligner, never as output.
LYRICTRACE_AUTO_SEARCH=true
# Minimum match score for using a hit without asking.
LYRICTRACE_AUTO_SELECT_THRESHOLD=0.6
# When the entry the lyrics came from has no 逐字 (word-level) data, look for it
# in another edition of the same song: NetEase lists the studio and live cuts
# separately, and the live one often has a yrc while the studio one does not.
# This is only the default for new projects — each project has its own switch
# (「查找其他版本逐字歌词」in the align panel).
LYRICTRACE_WORD_SYNC_SEARCH=true

# ---------------------------------------------------------------------------
# Model services
# ---------------------------------------------------------------------------
# Qwen3-ASR HTTP service (audio -> word-level JSON).
LYRICTRACE_ASR_URL=
LYRICTRACE_ASR_PROVIDER=qwen-asr-http
# Optional language hint, e.g. Japanese. Leave empty to let the ASR detect it.
LYRICTRACE_ASR_LANGUAGE=
LYRICTRACE_ASR_TIMEOUT=3600
# The ASR service's own forced aligner. Off by default: per-character timings
# come from the recogniser's own tokens (char_align), and on singing the ASR's
# aligner is the weaker of the two (upstream measured 80% zero-width Japanese
# characters). With it off, the word stream the line mapping runs on comes from
# the ASR's plain transcription. Turn it on to keep the ASR's character times
# as the fallback for lines the forced aligner cannot place.
LYRICTRACE_ASR_ALIGN=false

# BSRoformer.cpp vocal separation. On by default: a loud backing track is
# otherwise misheard as words, and line positioning depends on the recognition.
# Projects can turn it off when the vocal is already clean (faster).
LYRICTRACE_SEPARATOR_URL=
LYRICTRACE_SEPARATOR_PROVIDER=bs-roformer
LYRICTRACE_SEPARATOR_MODEL=becruily_deux-FP32
LYRICTRACE_SEPARATOR_TIMEOUT=1800

# Optional forced aligner: an extra opinion on each character's per-character
# time, used only when a project turns it on (see LYRICTRACE_CHAR_HFA).
LYRICTRACE_CHAR_ALIGNER_URL=
# Whether the forced aligner places characters at all. Off by default: the
# per-character table is then the recogniser's own, and no aligner request is
# made — one request per line is the cost of turning it on, and it is
# measurably more accurate (0.085 s against 0.140 s, median of per-song
# medians, six songs). A project can override this with its own ``hfa_chars``
# switch.
LYRICTRACE_CHAR_HFA=false
# When both backends ran, a character they agree on (within 0.3 s) keeps the
# recogniser's own boundary; where they disagree, or the recogniser only
# interpolated the character, the aligner's time is kept. Off: every character
# keeps the aligner's time.
LYRICTRACE_CHAR_FUSE=true
# When the ASR's window for a line does not hold up (text mismatch, mostly
# interpolated characters, a phrase squeezed into part of the clip), re-align it
# in windows shifted by up to 1.5 s and keep the best answer: the ASR decides
# where to look first, the aligner decides where the line actually is. Clean
# lines cost one request, doubtful ones up to eleven. Neighbouring lines bound
# the shifts, so two lines can never land on the same stretch.
LYRICTRACE_CHAR_ALIGN_SEARCH=true

# OpenAI-compatible LLM used to map lyric lines onto the ASR timings.
LYRICTRACE_LLM_BASE_URL=
LYRICTRACE_LLM_API_KEY=
LYRICTRACE_LLM_MODEL=
LYRICTRACE_LLM_TIMEOUT=300
# Default for a new project's 「按语意合并成词」 switch. Off: the finished
# timeline keeps one time per character, which is what was measured. On: the
# LLM says where the semantic boundaries are (君の / 心が / 見えない) — asked for
# boundaries only, never for times, and each unit takes the span of the
# characters it covers. Units that do not tile the line exactly are discarded
# and that line keeps its per-character times. The per-project field wins.
LYRICTRACE_LLM_MERGE=false

# LLM-guided alignment provider.
LYRICTRACE_ALIGNER_PROVIDER=llm-aligner
# Reserved.
LYRICTRACE_CORRECTOR_PROVIDER=unavailable
LYRICTRACE_IMPORTER_PROVIDER=unavailable

# ---------------------------------------------------------------------------
# Cache limits (see services/housekeeping)
# ---------------------------------------------------------------------------
# Everything below is a cache. The sweep runs at startup and then every
# LYRICTRACE_HOUSEKEEPING_INTERVAL_MIN minutes; GET /api/storage reports the
# sizes, POST /api/storage/cleanup sweeps on demand. Project rows, timelines and
# job.json are never touched — only files a run can regenerate.
# A finished one-shot job (data/oneshot/<job_id>/) is removed when it is older
# than the age limit, beyond the count limit, or the directory is over the size
# limit — oldest first.
# How many finished /api/align requests keep their source file *and* their
# per-character result. These are what GET /api/align lists and what the web
# UI's 「API 缓存」 page plays back; older jobs are swept. 5 is the default.
LYRICTRACE_ONESHOT_CACHE_JOBS=5
LYRICTRACE_ONESHOT_MAX_MB=2000
LYRICTRACE_ONESHOT_MAX_AGE_HOURS=24
# Keep a finished job's work/ dir (its 20 s ASR slices, ~100 MB per song). Off:
# dropped as soon as the job ends. Nothing reads it again.
LYRICTRACE_ONESHOT_KEEP_WORK=false
# Total size of data/work/ (per-project slices and the second-opinion cache).
# Project work dirs over this are removed oldest first; a project with a
# queued/running task is never swept.
LYRICTRACE_WORK_MAX_MB=2000
# An upload staged in data/oneshot/_uploads/ that never became a job is removed
# after this many minutes.
LYRICTRACE_UPLOAD_STALE_MINUTES=60
# Keep a project's work dir (prepared vocals + every per-line slice) after a
# run finishes. Off: the WAVs are dropped and the next run regenerates them;
# second-words.json (the second-opinion cache) is kept either way.
LYRICTRACE_KEEP_WORK_DIRS=false
# 0 disables the timer; POST /api/storage/cleanup still works.
LYRICTRACE_HOUSEKEEPING_INTERVAL_MIN=60
